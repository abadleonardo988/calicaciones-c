#include <stdio.h>

#define ESTUDIANTES 5
#define ASIGNATURAS 3

int main() {
    float calificaciones[ESTUDIANTES][ASIGNATURAS];
    float promedioEstudiante[ESTUDIANTES];
    float promedioAsignatura[ASIGNATURAS];
    int aprobados[ASIGNATURAS] = {0};
    int reprobados[ASIGNATURAS] = {0};

    // Ingreso de calificaciones con validación
    for (int i = 0; i < ESTUDIANTES; i++) {
        for (int j = 0; j < ASIGNATURAS; j++) {
            float nota;
            do {
                printf("Ingrese la nota del estudiante %d en la asignatura %d (0-10): ", i+1, j+1);
                scanf("%f", &nota);
                if (nota < 0 || nota > 10) {
                    printf(" Nota inválida. Debe estar entre 0 y 10.\n");
                }
            } while (nota < 0 || nota > 10);
            calificaciones[i][j] = nota;
        }
    }

    
    for (int i = 0; i < ESTUDIANTES; i++) {
        float suma = 0;
        float max = calificaciones[i][0];
        float min = calificaciones[i][0];
        for (int j = 0; j < ASIGNATURAS; j++) {
            suma += calificaciones[i][j];
            if (calificaciones[i][j] > max) max = calificaciones[i][j];
            if (calificaciones[i][j] < min) min = calificaciones[i][j];
        }
        promedioEstudiante[i] = suma / ASIGNATURAS;
        printf("\nEstudiante %d| Promedio: %.2f | Máx: %.2f | Mín: %.2f\n", i+1, promedioEstudiante[i], max, min);
    }

    
    for (int j = 0; j < ASIGNATURAS; j++) {
        float suma = 0;
        float max = calificaciones[0][j];
        float min = calificaciones[0][j];
        for (int i = 0; i < ESTUDIANTES; i++) {
            suma += calificaciones[i][j];
            if (calificaciones[i][j] > max) max = calificaciones[i][j];
            if (calificaciones[i][j] < min) min = calificaciones[i][j];

            
            if (calificaciones[i][j] >= 6) {
                aprobados[j]++;
            } else {
                reprobados[j]++;
            }
        }
        promedioAsignatura[j] = suma / ESTUDIANTES;
        printf("\nAsignatura %d → Promedio: %.2f | Máx: %.2f | Mín: %.2f | Aprobados: %d | Reprobados: %d\n",
               j+1, promedioAsignatura[j], max, min, aprobados[j], reprobados[j]);
    }

    return 0;
}

